# Copy this file to the gitignored .env.staging file, replace every
# __REPLACE_* placeholder locally, and then run `npm run staging:preflight`.
# No value below is a usable secret and no external secrets manager is required.

# Application and public ingress
APP_NAME="quickapi-nestjs"
APP_VERSION="1.2.0"
NODE_ENV="production"
PORT="4000"
LOG_LEVEL="info"
PUBLIC_API_URL="https://api.staging.your-domain.tld"
PUBLIC_WEB_URL="https://staging.your-domain.tld"
INGRESS_NETWORK="quickapi-staging-ingress"
TRUST_PROXY="172.20.0.0/24"
QUICKAPI_IMAGE="registry.your-domain.tld/quickapi@sha256:REPLACE_WITH_64_HEX_DIGEST"
NODE_OPTIONS="--max-old-space-size=384"

DOCUMENTATION_ENABLED="false"
METRICS_ENABLED="true"
DETAILED_DIAGNOSTICS_ENABLED="false"
OPERATIONS_TOKEN="__REPLACE_OPERATIONS_TOKEN_BEFORE_DEPLOYMENT__"

# CORS and transport (TLS terminates at the ingress)
CORS_ORIGINS="https://staging.your-domain.tld"
CORS_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-CSRF-Token,X-Operations-Key"
CORS_EXPOSED_HEADERS="Authorization,Set-Cookie"
CORS_CREDENTIALS="true"
CORS_MAX_AGE_SECONDS="86400"
HTTPS_ENABLED="false"
COOKIE_SECURE="true"
COOKIE_SAME_SITE="strict"
COOKIE_PATH="/"
COOKIE_DOMAIN="staging.your-domain.tld"
REFRESH_COOKIE_NAME="refresh_token"
REFRESH_COOKIE_MAX_AGE_DAYS="7"
CSRF_COOKIE_NAME="csrf_token"
CSRF_COOKIE_MAX_AGE_MINUTES="15"

# Files, requests, and throttling
STATIC_SERVE_ENABLED="false"
STATIC_ROOT_PATH="public"
STATIC_SERVE_ROOT="/"
UPLOAD_TMP_DIR="tmp"
ALLOWED_HTTP_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_CONTENT_TYPES="application/json,multipart/form-data"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="200"
REQUEST_TIMEOUT_MS="5000"
REQUEST_BODY_LIMIT_BYTES="1048576"
HEADER_MAX_COUNT="100"
HEADER_MAX_SINGLE_BYTES="4096"
HEADER_MAX_TOTAL_BYTES="8192"
HEADER_ALLOW_CHUNKED="false"
GLOBAL_THROTTLE_TTL_MINUTES="1"
GLOBAL_THROTTLE_LIMIT="200"

# MySQL: application values and image initialization values must agree.
DB_HOST="mysql"
DB_PORT="3306"
DB_USER="quickapi_staging"
DB_PASSWORD="__REPLACE_MYSQL_PASSWORD_BEFORE_DEPLOYMENT__"
DB_DATABASE="quickapi_staging"
DB_SYNC="false"
DB_SEED="false"
DB_SSL="false"
DB_SSL_REJECT_UNAUTHORIZED="true"
DB_POOL_CONNECTION_LIMIT="10"
DB_POOL_WAIT_FOR_CONNECTIONS="true"
DB_POOL_QUEUE_LIMIT="100"
DB_CONNECT_TIMEOUT_MS="10000"
DB_SLOW_QUERY_LOG_MS="1000"
MYSQL_ROOT_PASSWORD="__REPLACE_MYSQL_ROOT_PASSWORD_BEFORE_DEPLOYMENT__"
MYSQL_DATABASE="quickapi_staging"
MYSQL_USER="quickapi_staging"
MYSQL_PASSWORD="__REPLACE_MYSQL_PASSWORD_BEFORE_DEPLOYMENT__"
MYSQL_INNODB_BUFFER_POOL_SIZE="512M"
MYSQL_MAX_CONNECTIONS="50"

# Authentication
JWT_SECRET_KEY="__REPLACE_JWT_SECRET_KEY_BEFORE_DEPLOYMENT__"
REFRESH_SECRET_KEY="__REPLACE_REFRESH_SECRET_KEY_BEFORE_DEPLOYMENT__"
CRYPTO_SECRET="__REPLACE_CRYPTO_SECRET_BEFORE_DEPLOYMENT__"
JWT_EXPIRY_TIME="15m"
REFRESH_EXPIRY_TIME="7d"

# Redis and queue administration
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="__REPLACE_REDIS_PASSWORD_BEFORE_DEPLOYMENT__"
BULL_BOARD_ENABLED="false"
BULL_BOARD_ROUTE="/admin/queues"

# GeoLite2 data initialization
IP_LOCATION_DATA_DIR="/app/data/geoip"
MAXMIND_ACCOUNT_ID="__REPLACE_MAXMIND_ACCOUNT_ID_BEFORE_DEPLOYMENT__"
MAXMIND_LICENSE_KEY="__REPLACE_MAXMIND_LICENSE_KEY_BEFORE_DEPLOYMENT__"

# Selected staging email integration: Postmark
POSTMARK_ENABLED="true"
POSTMARK_SERVER_TOKEN="__REPLACE_POSTMARK_SERVER_TOKEN_BEFORE_DEPLOYMENT__"
POSTMARK_FROM_EMAIL="noreply@your-domain.tld"
POSTMARK_MESSAGE_STREAM="outbound"

# Selected staging object storage integration: Cloudflare R2
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID="__REPLACE_R2_ACCOUNT_ID_BEFORE_DEPLOYMENT__"
R2_ENDPOINT="https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="__REPLACE_R2_ACCESS_KEY_ID_BEFORE_DEPLOYMENT__"
R2_SECRET_ACCESS_KEY="__REPLACE_R2_SECRET_ACCESS_KEY_BEFORE_DEPLOYMENT__"
R2_BUCKET_NAME="quickapi-staging"
R2_PUBLIC_BASE_URL="https://assets.staging.your-domain.tld"