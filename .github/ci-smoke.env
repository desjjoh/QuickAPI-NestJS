APP_NAME=quickapi-nestjs
APP_VERSION=1.2.0
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=https://api.staging.quickapi.invalid
PUBLIC_WEB_URL=https://staging.quickapi.invalid
INGRESS_NETWORK=quickapi-ci
TRUST_PROXY=172.24.0.0/16
QUICKAPI_IMAGE=quickapi-ci@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DOCUMENTATION_ENABLED=false
METRICS_ENABLED=true
DETAILED_DIAGNOSTICS_ENABLED=true
OPERATIONS_TOKEN=ci-operations-key-not-a-production-secret
CORS_ORIGINS=https://staging.quickapi.invalid
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Operations-Key
CORS_EXPOSED_HEADERS=Authorization,Set-Cookie
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400
HTTPS_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_PATH=/
COOKIE_DOMAIN=staging.quickapi.invalid
STATIC_SERVE_ENABLED=false
ALLOWED_HTTP_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_CONTENT_TYPES=application/json,multipart/form-data
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
REQUEST_TIMEOUT_MS=5000
REQUEST_BODY_LIMIT_BYTES=1048576
HEADER_MAX_COUNT=100
HEADER_MAX_SINGLE_BYTES=4096
HEADER_MAX_TOTAL_BYTES=8192
HEADER_ALLOW_CHUNKED=false
GLOBAL_THROTTLE_TTL_MINUTES=1
GLOBAL_THROTTLE_LIMIT=200
DB_HOST=mysql
DB_PORT=3306
DB_USER=quickapi_ci
DB_PASSWORD=ci-mysql-password-not-production
DB_DATABASE=quickapi_ci
DB_SYNC=false
DB_SEED=false
DB_SSL=false
MYSQL_ROOT_PASSWORD=ci-root-password-not-production
MYSQL_DATABASE=quickapi_ci
MYSQL_USER=quickapi_ci
MYSQL_PASSWORD=ci-mysql-password-not-production
JWT_SECRET_KEY=1111111111111111111111111111111111111111111111111111111111111111
REFRESH_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222
CRYPTO_SECRET=3333333333333333333333333333333333333333333333333333333333333333
JWT_EXPIRY_TIME=15m
REFRESH_EXPIRY_TIME=7d
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ci-redis-password-not-production
BULL_BOARD_ENABLED=false
IP_LOCATION_DATA_DIR=/app/data/geoip
MAXMIND_ACCOUNT_ID=ci-account
MAXMIND_LICENSE_KEY=ci-license-key-not-production
POSTMARK_ENABLED=false
POSTMARK_SERVER_TOKEN=ci-postmark-token-not-production
POSTMARK_FROM_EMAIL=noreply@staging.quickapi.invalid
STORAGE_DRIVER=local
R2_ACCOUNT_ID=ci-r2-account
R2_ENDPOINT=https://ci-r2-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=ci-r2-access-key
R2_SECRET_ACCESS_KEY=ci-r2-secret-key
R2_BUCKET_NAME=quickapi-ci
R2_PUBLIC_BASE_URL=https://assets.staging.quickapi.invalid
