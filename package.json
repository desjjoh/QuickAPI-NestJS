{
  "name": "quickapi-nestjs",
  "version": "1.2.0",
  "description": "Same design goals as QuickAPI: clean structure, logging, error handling, persistence, and production Docker setup.",
  "author": "John Desjardins",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:verbose": "npm run test -- --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "test:db:safety": "node -r ts-node/register -r tsconfig-paths/register -e \"require('./test/helpers/database/safety').assertSafeTestDatabase()\"",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down --volumes --remove-orphans",
    "test:infra:logs": "docker compose -f docker-compose.test.yml logs --tail=200",
    "test:db:prepare": "TEST_DB_ENABLED=true TEST_DB_HOST=127.0.0.1 TEST_DB_PORT=3308 TEST_DB_USER=quickapi_test_app TEST_DB_PASSWORD=quickapi_test_password TEST_DB_DATABASE=quickapi_test DB_HOST=127.0.0.1 DB_PORT=3308 DB_USER=quickapi_test_app DB_PASSWORD=quickapi_test_password DB_DATABASE=quickapi_test DB_SYNC=false npm run migration:run",
    "test:e2e:local": "TEST_DB_ENABLED=true TEST_DB_HOST=127.0.0.1 TEST_DB_PORT=3308 TEST_DB_USER=quickapi_test_app TEST_DB_PASSWORD=quickapi_test_password TEST_DB_DATABASE=quickapi_test REDIS_HOST=127.0.0.1 REDIS_PORT=6380 REDIS_PASSWORD=quickapi_test_redis_password npm run test:e2e",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:e2e": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create src/database/migrations/migration",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/migration -d src/database/typeorm.datasource.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/typeorm.datasource.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/typeorm.datasource.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/typeorm.datasource.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/database/typeorm.datasource.ts",
    "docker:build": "docker build -t quickapi-nestjs .",
    "docker:api:up": "docker compose up -d api",
    "docker:migrate": "docker compose run --rm migration",
    "docker:api:logs": "docker compose logs -f api",
    "docker:api:stop": "docker compose stop api",
    "docker:mysql:up": "docker compose up -d mysql",
    "docker:mysql:stop": "docker compose stop mysql",
    "docker:mysql:logs": "docker compose logs -f mysql",
    "docker:redis:up": "docker compose up -d redis",
    "docker:redis:down": "docker compose stop redis",
    "docker:redis:restart": "docker compose restart redis",
    "docker:redis:logs": "docker compose logs -f redis",
    "docker:redis:status": "docker compose ps redis",
    "docker:up": "docker compose up -d --build --force-recreate",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps",
    "dev:db": "npm run docker:mysql:up && npm run migration:run",
    "geoip:seed": "ts-node -r tsconfig-paths/register src/modules/system/geolocation/scripts/seed-geolite2.ts",
    "geoip:update": "ts-node -r tsconfig-paths/register src/modules/system/geolocation/scripts/seed-geolite2.ts",
    "geoip:update:prod": "node dist/modules/system/geolocation/scripts/seed-geolite2.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/nestjs": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.1",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "colorette": "^2.0.20",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.9",
    "image-size": "^2.0.2",
    "maxmind": "^5.0.6",
    "moment": "^2.30.1",
    "mysql2": "^3.15.3",
    "nanoid": "^5.1.6",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.1.0",
    "postmark": "^4.0.7",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/moment": "^2.11.29",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.service.ts",
      "src/**/*.processor.ts",
      "src/**/*.guard.ts",
      "src/**/*.repository.ts",
      "!src/**/*.spec.ts",
      "!src/**/*.d.ts",
      "!src/**/dto/**",
      "!src/database/migrations/**",
      "!src/**/migrations/**",
      "!src/main.ts",
      "!src/**/*.generated.ts",
      "!src/**/__generated__/**"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 45,
        "lines": 65,
        "statements": 65
      },
      "src/modules/domain/identity/services/": {
        "branches": 75
      },
      "src/common/guards/permission.guard.ts": {
        "branches": 90
      },
      "src/modules/api/v1/authentication/services/": {
        "branches": 75
      },
      "src/modules/api/v1/account/services/": {
        "branches": 75
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
