# Checked-in, inert test configuration. Never load development .env for tests.
# TEST_* connection overrides are explicit; ordinary DB_*/REDIS_* values are ignored.
NODE_ENV=test
PORT=4000
LOG_LEVEL=silent
PUBLIC_API_URL=http://127.0.0.1:4000
PUBLIC_WEB_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token,Idempotency-Key
CORS_EXPOSED_HEADERS=Authorization,Set-Cookie,X-Request-ID
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=60
HTTPS_ENABLED=false
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=strict
COOKIE_PATH=/
DOCUMENTATION_ENABLED=false
METRICS_ENABLED=false
DETAILED_DIAGNOSTICS_ENABLED=false
BULL_BOARD_ENABLED=false
STATIC_SERVE_ENABLED=false
ALLOWED_HTTP_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_CONTENT_TYPES=application/json,multipart/form-data
GLOBAL_THROTTLE_TTL_MINUTES=1
GLOBAL_THROTTLE_LIMIT=200
JWT_SECRET_KEY=1111111111111111111111111111111111111111111111111111111111111111
REFRESH_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222
CRYPTO_SECRET=3333333333333333333333333333333333333333333333333333333333333333
JWT_EXPIRY_TIME=15m
REFRESH_EXPIRY_TIME=7d

# Disposable local MySQL/Redis; keep in sync with docker-compose.test.yml.
TEST_DB_ENABLED=true
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3308
TEST_DB_USER=quickapi_test_app
TEST_DB_PASSWORD=quickapi_test_password
TEST_DB_DATABASE=quickapi_test
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6380
TEST_REDIS_PASSWORD=quickapi_test_redis_password
DB_SYNC=false
DB_SEED=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_WAIT_FOR_CONNECTIONS=true
DB_POOL_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_SLOW_QUERY_LOG_MS=1000

# Fake external providers: HTTP suites replace clients; never use real credentials.
POSTMARK_ENABLED=false
POSTMARK_SERVER_TOKEN=POSTMARK_TEST_TOKEN
POSTMARK_FROM_EMAIL=noreply@test.example.com
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=cloudflare-test-account
R2_ENDPOINT=https://cloudflare-test-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=R2_TEST_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=R2_TEST_SECRET_ACCESS_KEY
R2_BUCKET_NAME=quickapi-test
R2_PUBLIC_BASE_URL=https://assets.test.example.com
